# Copy to .env.local for local development. On Netlify, set these in Site configuration → Environment variables.
# Local development needs NONE of the service variables: it uses an embedded Postgres (PGlite), local disk for
# CVs and an in-process queue. Only an AI key is needed to see rankings.

# ── AI provider (the only paid part) ────────────────────────────────────────
# Set at least one key. Without AI_PROVIDER, Gemini is used if its key is set,
# otherwise the first configured provider in this order: gemini, openai, anthropic, groq, openai-compatible.
# If the chosen provider fails, the others that have keys are tried in that order (disable with AI_FALLBACK=false).
AI_PROVIDER=            # gemini | openai | anthropic | groq | openai-compatible
AI_FALLBACK=true
AI_CONCURRENCY=3        # local in-process mode only: CVs analyzed in parallel (companies take turns)
AI_DAILY_LIMIT=500      # AI analyses per company per UTC day (re-scores count); 0 = unlimited

GEMINI_API_KEY=         # or GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible API (DeepSeek, Mistral, OpenRouter, Together, Ollama, …)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── Database: Neon Postgres (free plan) ─────────────────────────────────────
# Production: the Neon *pooled* connection string. Leave empty locally to use embedded PGlite in ./data/pglite.
DATABASE_URL=
# PGLITE_DIR=./data/pglite

# ── Background jobs: Inngest (free plan) ────────────────────────────────────
# From app.inngest.com → your app → Event key / Signing key. Required on Netlify (no long-running process there).
# Locally, leave empty to use the in-process queue (or set INNGEST_DEV=1 and run `npx inngest-cli dev`).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── CV file storage ─────────────────────────────────────────────────────────
# netlify-blobs on Netlify (automatic, free), local disk elsewhere.
# STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads

# ── Network ─────────────────────────────────────────────────────────────────
# Off Netlify only: reverse proxies in front of the app that append to X-Forwarded-For (per-IP rate limits).
# On Netlify the trusted x-nf-client-connection-ip header is used instead.
TRUST_PROXY_HOPS=1

# ── Platform admin (seeded on server start) ─────────────────────────────────
# Created once if no user with this email exists; never overwrites an existing password.
# The admin creates company invite links from Dashboard → Invites (or use `pnpm invite`).
ADMIN_EMAIL=
ADMIN_PASSWORD=          # at least 12 characters
ADMIN_NAME=Admin
ADMIN_COMPANY_NAME=Shortlist

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used by `pnpm invite` to print signup links.
APP_URL=http://localhost:3000

# ── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Shortlist
